{
  "entity": "loans",
  "version": "1.0.0",
  "description": "Amortizing loans with origination-time borrower attributes.",
  "primary_key": ["loan_id"],
  "columns": [
    {"name": "loan_id", "type": "string", "nullable": false, "pattern": "^LOAN_[0-9]{8}$"},
    {"name": "customer_id", "type": "string", "nullable": false, "pattern": "^CUST_[0-9]{8}$"},
    {"name": "loan_type", "type": "string", "nullable": false,
     "allowed": ["auto", "personal", "mortgage", "student"]},
    {"name": "principal", "type": "float", "nullable": false, "min": 0},
    {"name": "apr", "type": "float", "nullable": false, "min": 0, "max": 1},
    {"name": "term_months", "type": "integer", "nullable": false, "min": 1, "max": 480},
    {"name": "origination_date", "type": "date", "nullable": false},
    {"name": "monthly_payment", "type": "float", "nullable": false, "min": 0},
    {"name": "credit_score_at_origination", "type": "integer", "nullable": false, "min": 300, "max": 850},
    {"name": "dti_at_origination", "type": "float", "nullable": false, "min": 0, "max": 1},
    {"name": "defaulted", "type": "boolean", "nullable": false}
  ]
}
